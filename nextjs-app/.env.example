# Required in production: a long random string (e.g. openssl rand -base64 32)
AUTH_SECRET=

# First admin account, created automatically if no admin exists yet.
# Choose your own strong password; change it after first sign-in.
ADMIN_EMAIL=admin@pakistanjobs.blog
ADMIN_PASSWORD=

# Database (required on Vercel/serverless). Add the Upstash Redis integration
# from the Vercel Marketplace and these are filled in for you.
# (KV_REST_API_URL / KV_REST_API_TOKEN are also accepted.)
# Without these, local dev stores data in .data/db.json.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
