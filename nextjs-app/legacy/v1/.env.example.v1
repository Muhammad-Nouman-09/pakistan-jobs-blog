# ---------------------------------------------------------------------------
# Pakistan Jobs Portal — environment variables.
# Copy to .env.local and fill in. NEVER commit real values.
# ---------------------------------------------------------------------------

# Supabase (Project Settings → API). The URL and the publishable/anon key are safe for the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY. Bypasses Row Level Security. Never prefix with NEXT_PUBLIC_, never commit, never log.
# Used for: rate limiting, the expiry cron, the admin-provisioning and legacy-migration scripts.
SUPABASE_SERVICE_ROLE_KEY=

# Canonical public origin, no trailing slash. Used for canonical URLs, sitemap, hreflang and e-mail links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shared secret for the daily expiry cron (/api/cron/expire-jobs). Use a long random string.
# On Vercel, Cron sends it automatically as `Authorization: Bearer $CRON_SECRET`.
CRON_SECRET=

# Optional: transactional e-mail for company invitations (https://resend.com). If unset, the invitation
# link is shown to the inviting owner so they can send it themselves.
RESEND_API_KEY=
EMAIL_FROM="Pakistan Jobs <no-reply@example.com>"

# --- One-off scripts only (not read by the running app) --------------------------------------------
# npm run admin:provision      needs ADMIN_EMAIL (the account to promote; created + invited if missing)
# npm run migrate:legacy       needs LEGACY_REDIS_URL + LEGACY_REDIS_TOKEN (the old UPSTASH_REDIS_REST_* values)
#                              or LEGACY_DB_FILE=.data/db.json for a local dev database
ADMIN_EMAIL=
LEGACY_REDIS_URL=
LEGACY_REDIS_TOKEN=
LEGACY_DB_FILE=
